---
/**
 * Discography — a responsive grid of releases with cover art.
 *
 * Hover lifts the cover and reveals the primary listen link; the whole card
 * is keyboard-reachable. Covers use a square aspect ratio so mismatched art
 * still lines up cleanly.
 */
import type { Release } from '../../lib/music';

interface Props {
  releases: Release[];
  class?: string;
}

const { releases, class: className = '' } = Astro.props;
---

<ul class={`grid grid-cols-2 gap-5 sm:grid-cols-3 lg:grid-cols-4 ${className}`}>
  {
    releases.map((r) => {
      const primary = r.links?.[0];
      return (
        <li class="group">
          <div class="bg-stage-raised relative aspect-square overflow-hidden rounded-xl border border-white/10">
            <img
              src={r.cover}
              alt={`${r.title} cover art`}
              loading="lazy"
              class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
            />
            {primary && (
              <a
                href={primary.url}
                target="_blank"
                rel="noopener"
                class="bg-stage/70 absolute inset-0 flex items-end p-3 opacity-0 backdrop-blur-[2px] transition-opacity duration-300 group-hover:opacity-100 focus-visible:opacity-100"
              >
                <span class="bg-signal text-stage rounded-full px-3 py-1.5 text-xs font-bold">
                  {primary.label} →
                </span>
              </a>
            )}
          </div>
          <div class="mt-3">
            <p class="text-muted text-xs tracking-wide uppercase">
              {r.kind} · {r.year}
            </p>
            <p class="text-bone mt-0.5 font-medium">{r.title}</p>
          </div>
        </li>
      );
    })
  }
</ul>
