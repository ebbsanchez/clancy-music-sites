---
import Equalizer from './Equalizer.astro';
import StreamingEmbed from './music/StreamingEmbed.astro';
import Discography from './music/Discography.astro';
import TourDates from './music/TourDates.astro';
import Bio from './music/Bio.astro';
import PressKit from './music/PressKit.astro';
import LinkHub from './music/LinkHub.astro';
import type { DemoSite } from '../lib/demoPack';

interface Props {
  site: DemoSite;
}

const { site } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const isPunk = site.type === 'punk';
const isAnime = site.type === 'anime';
const isLiquid = site.type === 'liquid';
---

<main
  class={`demo-site min-h-screen overflow-hidden ${isPunk ? 'demo-punk' : ''} ${
    isAnime ? 'demo-anime' : ''
  } ${isLiquid ? 'demo-liquid' : ''}`}
  style={`--demo-bg:${site.palette.bg};--demo-panel:${site.palette.panel};--demo-text:${site.palette.text};--demo-muted:${site.palette.muted};--demo-accent:${site.palette.accent};--demo-accent-2:${site.palette.accent2};--demo-line:${site.palette.line};`}
>
  <header
    class="relative z-10 mx-auto flex max-w-7xl items-center justify-between px-5 py-5 sm:px-8"
  >
    <a href={`${base}/demos`} class="demo-kicker inline-flex items-center gap-2 no-underline">
      <Equalizer bars={3} class="h-4" />
      Demo Pack A
    </a>
    <nav class="hidden gap-2 sm:flex">
      <a href="#music" class="demo-nav">Music</a>
      <a href="#shows" class="demo-nav">Shows</a>
      <a href="#press" class="demo-nav">EPK</a>
    </nav>
  </header>

  <section
    class="demo-hero relative z-10 mx-auto grid max-w-7xl gap-8 px-5 pb-14 sm:px-8 lg:grid-cols-[1.1fr_0.9fr] lg:items-end lg:pb-20"
  >
    <div class="demo-hero-copy">
      <p class="demo-kicker mb-5">{site.title}</p>
      <h1 class="demo-title">{site.name}</h1>
      <p class="demo-description">{site.description}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#music" class="demo-button">Listen</a>
        <a href="#shows" class="demo-button demo-button-alt">Tour dates</a>
      </div>
    </div>

    <figure class="demo-portrait">
      <img src={site.heroImage} alt={`${site.name} live visual`} />
      <figcaption>{site.scene}</figcaption>
    </figure>
  </section>

  <section id="music" class="demo-band">
    <div class="demo-section-head">
      <p class="demo-kicker">Featured release</p>
      <h2>Start with sound.</h2>
    </div>
    <div class="grid gap-6 lg:grid-cols-[0.95fr_1.05fr] lg:items-start">
      <div class="space-y-4">
        {site.embeds.map((embed) => <StreamingEmbed {...embed} />)}
      </div>
      <Discography releases={site.releases} />
    </div>
  </section>

  <section id="shows" class="demo-band demo-band-tight">
    <div class="demo-section-head">
      <p class="demo-kicker">Live</p>
      <h2>Dates that scan fast.</h2>
    </div>
    <TourDates shows={site.shows} since="2026-07-01" />
  </section>

  <section class="demo-band">
    <div class="demo-section-head">
      <p class="demo-kicker">Artist story</p>
      <h2>Bio without filler.</h2>
    </div>
    <Bio {...site.bio} />
  </section>

  <section id="press" class="demo-band">
    <div class="demo-section-head">
      <p class="demo-kicker">For press and bookers</p>
      <h2>EPK in one scroll.</h2>
    </div>
    <PressKit {...site.pressKit} />
  </section>

  <section class="demo-band demo-links">
    <div class="demo-section-head">
      <p class="demo-kicker">Everywhere</p>
      <h2>One clean link hub.</h2>
    </div>
    <LinkHub links={site.links} />
  </section>
</main>
