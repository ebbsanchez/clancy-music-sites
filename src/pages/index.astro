---
import Base from '../layouts/Base.astro';
import Equalizer from '../components/Equalizer.astro';
import { demoPackB } from '../lib/demoPackB';

// Deploy-pipeline proof page. Deliberately opinionated — this is the taste
// bar for the product, not a throwaway "Hello World".
const ticker = [
  'Spotify embeds',
  'Tour dates',
  'Discography',
  'EPK / press kit',
  'Bandcamp',
  'Link hub',
  'AI-assisted editing',
  'Apple Music',
];
const buildStamp = new Date().toISOString().slice(0, 10);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base>
  <main class="relative min-h-screen overflow-hidden">
    <!-- Ambient stage glow -->
    <div
      class="pointer-events-none absolute -top-40 left-1/2 h-[560px] w-[560px] -translate-x-1/2 rounded-full opacity-30 blur-[120px]"
      style="background: radial-gradient(circle, var(--color-signal) 0%, transparent 70%)"
      aria-hidden="true"
    >
    </div>

    <!-- Top bar -->
    <header
      class="relative z-10 mx-auto flex max-w-6xl items-center justify-between px-6 py-6 sm:px-10"
    >
      <a href="/" class="flex items-center gap-2.5 no-underline">
        <span class="flex h-6 w-6 items-end justify-center">
          <Equalizer bars={3} class="h-4" />
        </span>
        <span class="text-bone text-sm font-bold tracking-[0.2em] uppercase">Clancy</span>
      </a>
      <span
        class="text-muted hidden rounded-full border border-white/10 px-3 py-1 text-xs tracking-wide sm:inline"
      >
        Studio · est. 2026
      </span>
    </header>

    <!-- Hero -->
    <section class="relative z-10 mx-auto max-w-6xl px-6 pt-16 pb-14 sm:px-10 sm:pt-24">
      <p class="text-signal mb-6 flex items-center gap-3 text-sm tracking-wide">
        <Equalizer bars={4} class="h-4" />
        Now building
      </p>

      <h1
        class="font-display text-[15vw] leading-[0.86] font-light tracking-[-0.03em] text-balance sm:text-[9rem]"
      >
        Websites<br />
        <span class="text-signal italic">for musicians.</span>
      </h1>

      <p class="text-muted mt-8 max-w-xl text-lg leading-relaxed text-pretty sm:text-xl">
        We build artist sites that are easy to read, effortless to edit, and unmistakably
        <span class="text-bone">not a template</span>. Streaming players, tour dates, discography,
        press kits — composed with taste, editable in plain language.
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-4">
        <span
          class="bg-signal text-stage inline-flex items-center gap-2 rounded-full px-5 py-2.5 text-sm font-bold"
        >
          Foundation live
          <span class="bg-stage inline-block h-2 w-2 animate-pulse rounded-full"></span>
        </span>
        <a
          href={`${base}/components`}
          class="border-signal/40 text-signal hover:bg-signal hover:text-stage inline-flex items-center gap-2 rounded-full border px-5 py-2.5 text-sm font-bold no-underline transition-colors"
        >
          View component library →
        </a>
        <a
          href={`${base}/demos`}
          class="border-signal/40 text-signal hover:bg-signal hover:text-stage inline-flex items-center gap-2 rounded-full border px-5 py-2.5 text-sm font-bold no-underline transition-colors"
        >
          Open demo packs →
        </a>
        <a
          href={`${base}/pricing`}
          class="border-signal/40 text-signal hover:bg-signal hover:text-stage inline-flex items-center gap-2 rounded-full border px-5 py-2.5 text-sm font-bold no-underline transition-colors"
        >
          Pricing architecture →
        </a>
        <span class="text-muted text-sm">Preview pipeline online · build {buildStamp}</span>
      </div>
    </section>

    <section class="relative z-10 mx-auto max-w-6xl px-6 py-12 sm:px-10">
      <div class="mb-6 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-signal text-sm tracking-wide uppercase">Reference sites</p>
          <h2 class="font-display mt-2 text-4xl leading-none font-light sm:text-6xl">
            Demo pack B
          </h2>
        </div>
        <a href={`${base}/demos`} class="text-muted hover:text-signal text-sm transition-colors">
          View all demos →
        </a>
      </div>
      <div class="grid gap-4 md:grid-cols-3">
        {
          demoPackB.map((artist) => (
            <a
              href={`${base}/demos/${artist.slug}`}
              class="bg-stage-raised group block overflow-hidden rounded-2xl border border-white/10 no-underline transition-transform hover:-translate-y-1"
            >
              <img
                src={artist.heroImage.src}
                alt=""
                class="aspect-[5/4] w-full object-cover"
                loading="lazy"
              />
              <div class="p-5">
                <p class="text-signal text-xs tracking-wide uppercase">{artist.genre}</p>
                <h3 class="text-bone mt-2 text-xl font-bold">{artist.name}</h3>
                <p class="text-muted mt-2 line-clamp-2 text-sm leading-relaxed">
                  {artist.headline}
                </p>
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <!-- Ticker -->
    <div
      class="bg-stage-raised/60 relative z-10 border-y border-white/10 py-4 backdrop-blur-sm"
      aria-hidden="true"
    >
      <div class="flex overflow-hidden">
        <div class="marquee-track flex shrink-0 items-center gap-8 pr-8 whitespace-nowrap">
          {
            [...ticker, ...ticker].map((item) => (
              <span class="text-muted flex items-center gap-8 text-sm tracking-wide">
                {item}
                <span class="text-signal">✳</span>
              </span>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Footer -->
    <footer
      class="text-muted relative z-10 mx-auto flex max-w-6xl flex-col gap-2 px-6 py-10 text-sm sm:flex-row sm:items-center sm:justify-between sm:px-10"
    >
      <span>Clancy Website Design</span>
      <span>Astro · TypeScript · Tailwind — auto-deployed on every commit.</span>
    </footer>
  </main>
</Base>
