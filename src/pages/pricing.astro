---
import Base from '../layouts/Base.astro';
import { operations, pricingTiers } from '../lib/pricing';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base
  title="Pricing Architecture — Clancy"
  description="Clancy Website Design 音樂人網站定價、交付與維運架構。"
>
  <main class="pricing-shell">
    <nav class="pricing-nav" aria-label="頁面導覽">
      <a href={`${base}/`} class="brand">CLANCY / PRICING LAB</a><div>
        <a href="#packages">方案</a><a href="#operations">維運</a><a href="#handoff">交付</a>
      </div>
    </nav>
    <header class="hero">
      <p class="kicker">MUSICIAN WEBSITE / COMMERCIAL ARCHITECTURE / 2026.07</p><h1>
        不是替頁面<br />標價。<em>是替價值<br />劃清界線。</em>
      </h1><div class="hero-grid">
        <p>四種價位不是同一個網站的大小版本，而是四種不同的承諾、流程、風險與交付責任。</p><dl>
          <div><dt>建議核心方案</dt><dd>$2,000 Signature</dd></div><div>
            <dt>低價方案原則</dt><dd>嚴格套版，不客製</dd>
          </div><div><dt>高價方案原則</dt><dd>先賣 discovery</dd></div>
        </dl>
      </div>
    </header>
    <section class="decision-strip" aria-label="快速定價判斷">
      <p>快速判斷</p><span>只要正式上線 → $200</span><span>需要專屬辨識 → $2k</span><span
        >需要營運系統 → $10k</span
      ><span>網站就是作品 → $20k+</span>
    </section>
    <section id="packages" class="section">
      <div class="section-heading">
        <p>01 / OFFERS</p><h2>四個價位，四種生意。</h2><p>
          點選價位篩選。Demo
          是視覺與元件基線；高價來自策略、系統、整合與風險，不是「看起來更漂亮」。
        </p>
      </div><div class="tier-filter" role="group" aria-label="篩選價位">
        <button class="is-active" data-filter="all">全部</button>{
          pricingTiers.map((tier) => <button data-filter={tier.id}>{tier.price}</button>)
        }
      </div><div class="tiers">
        {
          pricingTiers.map((tier) => (
            <article class={`tier tier--${tier.accent}`} data-tier={tier.id}>
              <>
                <div class="tier-top">
                  <>
                    <p>{tier.eyebrow}</p>
                    <span>{tier.price}</span>
                  </>
                </div>
                <h3>{tier.promise}</h3>
                <p class="fit">適合：{tier.fit}</p>
                <div class="metrics">
                  <>
                    <div>
                      <>
                        <small>內部工時上限</small>
                        <strong>{tier.hours}</strong>
                      </>
                    </div>
                    <div>
                      <>
                        <small>交期</small>
                        <strong>{tier.weeks}</strong>
                      </>
                    </div>
                  </>
                </div>
                <p class="guardrail">毛利護欄 / {tier.marginGuardrail}</p>
                <div class="tier-columns">
                  <>
                    <div>
                      <>
                        <h4>客戶拿到什麼</h4>
                        <ul>
                          {tier.deliverables.map((item) => (
                            <li>{item}</li>
                          ))}
                        </ul>
                      </>
                    </div>
                    <div>
                      <>
                        <h4>明確不包含</h4>
                        <ul class="muted-list">
                          {tier.exclusions.map((item) => (
                            <li>{item}</li>
                          ))}
                        </ul>
                      </>
                    </div>
                  </>
                </div>
                <div class="workflow">
                  <h4>內部 Workflow</h4>
                  {tier.workflow.map((step) => (
                    <div>
                      <span>{step.label}</span>
                      <b>{step.value}</b>
                    </div>
                  ))}
                </div>
                <div class="demo-links">
                  <h4>對應既有 Demo</h4>
                  {tier.demos.map((demo) => (
                    <a href={`${base}/demos/${demo.slug}/`}>
                      <span>↗ {demo.name}</span>
                      <small>{demo.note}</small>
                    </a>
                  ))}
                </div>
              </>
            </article>
          ))
        }
      </div>
    </section>
    <section id="operations" class="section section--light">
      <div class="section-heading">
        <p>02 / OPERATIONS</p><h2>讓客戶付平台費，<br />讓 Clancy 收專業費。</h2><p>
          網域、託管、CMS
          與付費服務原則上都放在客戶帳號與信用卡。這能避免代墊、帳號綁架與日後搬家爭議。
        </p>
      </div><div class="ops-grid">
        {
          operations.map((op) => (
            <article>
              <>
                <p>{op.bestFor}</p>
                <h3>{op.model}</h3>
                <dl>
                  <>
                    <div>
                      <>
                        <dt>平台成本</dt>
                        <dd>{op.monthly}</dd>
                      </>
                    </div>
                    <div>
                      <>
                        <dt>Clancy 工時</dt>
                        <dd>{op.internal}</dd>
                      </>
                    </div>
                  </>
                </dl>
                <p>{op.detail}</p>
              </>
            </article>
          ))
        }
      </div><aside class="maintenance">
        <div><p>建議維護品項</p><h3>不要承諾「永久免費修改」。</h3></div><ul>
          <li><b>$75 / 次</b><span>30 分鐘內的小更新</span></li><li>
            <b>$200 / 月</b><span>每月最多 2 小時、48h 回應</span>
          </li><li><b>$600+ / 月</b><span>成長、內容與技術維運 retainer</span></li>
        </ul>
      </aside>
    </section>
    <section id="handoff" class="section">
      <div class="section-heading">
        <p>03 / HANDOFF</p><h2>交付不是丟一個網址。</h2><p>
          每個專案都應用同一個移交流程，讓「完成」有可驗收的定義。
        </p>
      </div><ol class="handoff">
        <li>
          <span>01</span><div>
            <h3>帳號與所有權</h3><p>
              網域、託管、CMS、分析與金流帳號列冊；客戶是 owner，Clancy 是 collaborator。
            </p>
          </div>
        </li><li>
          <span>02</span><div>
            <h3>內容與功能驗收</h3><p>
              以 scope checklist 驗收頁面、裝置、表單、連結、SEO、效能與無障礙；書面 sign-off。
            </p>
          </div>
        </li><li>
          <span>03</span><div>
            <h3>操作教學</h3><p>
              $2k 以上提供錄影與 60 分鐘教學；只教客戶會改的內容，不暴露容易破壞版面的權限。
            </p>
          </div>
        </li><li>
          <span>04</span><div>
            <h3>保固與維護</h3><p>
              定義 bug 保固期、回應時間與「新需求」界線；期滿轉單次更新或月維護。
            </p>
          </div>
        </li><li>
          <span>05</span><div>
            <h3>封存與退出</h3><p>
              交付 repo、設計檔、內容匯出、密碼管理清單與復原方式；確認最後一筆款項。
            </p>
          </div>
        </li>
      </ol>
    </section>
    <section class="section section--sources">
      <div class="section-heading"><p>04 / EVIDENCE</p><h2>市場訊號與成本基線。</h2></div><div
        class="sources"
      >
        <a href="https://kane-design.com/artist-website-package/"
          ><span>Artist-specific entry offer</span><b>Kane Design — $200 setup</b></a
        ><a href="https://showman-media.com/web-design/"
          ><span>Specialist musician studio</span><b>Showman Media — from €2,000</b></a
        ><a href="https://bandzoogle.com/help/articles/363-bandzoogle-pricing"
          ><span>DIY replacement cost</span><b>Bandzoogle — $6.95–22/mo</b></a
        ><a href="https://vercel.com/pricing"
          ><span>Managed hosting baseline</span><b>Vercel — $0 Hobby / $20 Pro</b></a
        ><a
          href="https://help.webflow.com/hc/en-us/articles/51059955082387-Updated-pricing-and-simplified-plans-for-May-2026"
          ><span>CMS platform volatility</span><b>Webflow — May 2026 plan changes</b></a
        ><a href="https://stripe.com/pricing"
          ><span>Commerce variable cost</span><b>Stripe — 2.9% + 30¢ US baseline</b></a>
      </div><p class="caveat">
        研究解讀：$200 市場存在，但本質是產品化入口，不是客製專案。$2k
        有音樂網站專門供應商的公開價格支持。$10k–20k 不是靠頁數推算，而是一般客製工程 $5k–30k
        市場範圍加上策略、互動、整合與營運責任後的 Clancy
        產品設計。所有第三方價格應在正式報價日再次確認。
      </p>
    </section>
  </main>
  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const tiers = document.querySelectorAll<HTMLElement>('[data-tier]');
    buttons.forEach((button) =>
      button.addEventListener('click', () => {
        buttons.forEach((item) => item.classList.remove('is-active'));
        button.classList.add('is-active');
        tiers.forEach((tier) => {
          tier.hidden =
            button.dataset.filter !== 'all' && tier.dataset.tier !== button.dataset.filter;
        });
      })
    );
  </script>
</Base>
<style>
  :global(body) {
    background: #0b0b0c;
    color: #f3f0e8;
  }
  .pricing-shell {
    --p-ink: #0b0b0c;
    --p-paper: #f3f0e8;
    --p-line: rgba(243, 240, 232, 0.2);
    --p-muted: #a6a39d;
    --p-accent: #d8ff62;
    --p-card: #151517;
    --p-card-border: var(--p-line);
    font-family: Arial, Helvetica, sans-serif;
  }
  .pricing-nav {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem clamp(1.25rem, 4vw, 4rem);
    background: rgba(11, 11, 12, 0.88);
    border-bottom: 1px solid var(--p-line);
    backdrop-filter: blur(16px);
  }
  .pricing-nav a {
    color: inherit;
    text-decoration: none;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
  }
  .pricing-nav div {
    display: flex;
    gap: 1.5rem;
  }
  .brand {
    font-weight: 800;
  }
  .hero,
  .section {
    padding: clamp(4rem, 9vw, 8rem) clamp(1.25rem, 6vw, 6rem);
  }
  .hero {
    min-height: 84vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: radial-gradient(circle at 85% 20%, rgba(216, 255, 98, 0.15), transparent 28%);
  }
  .kicker,
  .section-heading > p,
  .tier-top p {
    font: 700 0.68rem/1.2 monospace;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--p-accent);
  }
  .hero h1 {
    margin: 3rem 0;
    font-size: clamp(3.8rem, 10vw, 9rem);
    line-height: 0.82;
    letter-spacing: -0.07em;
    text-transform: uppercase;
  }
  .hero h1 em {
    color: var(--p-accent);
    font-style: normal;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: end;
  }
  .hero-grid > p {
    max-width: 36rem;
    font-size: clamp(1.25rem, 2vw, 2rem);
    line-height: 1.25;
  }
  .hero dl {
    margin: 0;
  }
  .hero dl div {
    display: flex;
    justify-content: space-between;
    padding: 0.7rem 0;
    border-top: 1px solid var(--p-line);
    font-size: 0.85rem;
  }
  .hero dt {
    color: var(--p-muted);
  }
  .decision-strip {
    display: grid;
    grid-template-columns: 0.7fr repeat(4, 1fr);
    border-block: 1px solid var(--p-line);
  }
  .decision-strip > * {
    margin: 0;
    padding: 1.2rem;
    border-right: 1px solid var(--p-line);
    font-size: 0.75rem;
  }
  .decision-strip p {
    color: var(--p-accent);
    font: 700 0.7rem monospace;
  }
  .section-heading {
    display: grid;
    grid-template-columns: 0.55fr 1.45fr 1fr;
    gap: 2rem;
    align-items: start;
    margin-bottom: 3rem;
  }
  .section-heading h2 {
    margin: 0;
    font-size: clamp(2.5rem, 5vw, 5.8rem);
    line-height: 0.9;
    letter-spacing: -0.055em;
  }
  .section-heading > p:last-child {
    color: var(--p-muted);
    font: 400 1rem/1.6 Arial;
  }
  .tier-filter {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
    overflow: auto;
  }
  .tier-filter button {
    min-height: 2.75rem;
    padding: 0 1.2rem;
    border: 1px solid var(--p-line);
    border-radius: 99px;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }
  .tier-filter button:hover,
  .tier-filter button:focus-visible,
  .tier-filter button.is-active {
    background: var(--p-accent);
    color: var(--p-ink);
    outline: none;
  }
  .tiers {
    display: grid;
    gap: 1rem;
  }
  .tier {
    --tier-accent: var(--p-accent);
    padding: clamp(1.25rem, 3vw, 3rem);
    border: 1px solid var(--p-card-border);
    background: var(--p-card);
  }
  .tier--coral {
    --tier-accent: #ff826c;
  }
  .tier--violet {
    --tier-accent: #c4a7ff;
  }
  .tier--blue {
    --tier-accent: #76c7ff;
  }
  .tier-top {
    display: flex;
    justify-content: space-between;
    align-items: start;
  }
  .tier-top p {
    color: var(--tier-accent);
  }
  .tier-top span {
    font-size: clamp(3.5rem, 8vw, 8rem);
    line-height: 0.8;
    letter-spacing: -0.07em;
    color: var(--tier-accent);
  }
  .tier h3 {
    max-width: 58rem;
    margin: 3rem 0 1rem;
    font-size: clamp(1.8rem, 3vw, 3.2rem);
    line-height: 1.05;
  }
  .fit {
    color: var(--p-muted);
  }
  .metrics {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    margin: 2rem 0;
    background: var(--p-line);
  }
  .metrics div {
    padding: 1.2rem;
    background: var(--p-card);
  }
  .metrics small {
    display: block;
    color: var(--p-muted);
  }
  .metrics strong {
    display: block;
    margin-top: 0.4rem;
    font-size: 1.35rem;
  }
  .guardrail {
    padding: 0.9rem 1.1rem;
    border-left: 3px solid var(--tier-accent);
    background: rgba(255, 255, 255, 0.04);
    font: 700 0.78rem/1.4 monospace;
  }
  .tier-columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    margin: 3rem 0;
  }
  .tier h4 {
    font: 700 0.72rem monospace;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--tier-accent);
  }
  .tier ul {
    padding: 0;
    list-style: none;
  }
  .tier li {
    padding: 0.45rem 0;
    border-bottom: 1px solid var(--p-line);
  }
  .tier li:before {
    content: '＋';
    margin-right: 0.6rem;
    color: var(--tier-accent);
  }
  .tier .muted-list {
    color: var(--p-muted);
  }
  .tier .muted-list li:before {
    content: '—';
  }
  .workflow {
    margin: 2rem 0;
  }
  .workflow div {
    display: flex;
    justify-content: space-between;
    padding: 0.75rem 0;
    border-top: 1px solid var(--p-line);
  }
  .demo-links {
    display: grid;
    grid-template-columns: 0.7fr repeat(3, 1fr);
    gap: 1px;
    background: var(--p-line);
  }
  .demo-links > * {
    margin: 0;
    padding: 1rem;
    background: var(--p-card);
  }
  .demo-links a {
    color: inherit;
    text-decoration: none;
  }
  .demo-links a:hover span,
  .demo-links a:focus-visible span {
    color: var(--tier-accent);
  }
  .demo-links span,
  .demo-links small {
    display: block;
  }
  .demo-links small {
    margin-top: 0.5rem;
    color: var(--p-muted);
    line-height: 1.35;
  }
  .section--light {
    background: var(--p-paper);
    color: var(--p-ink);
    --p-line: rgba(11, 11, 12, 0.2);
    --p-muted: #5d5a55;
    --p-card: #ebe7de;
  }
  .ops-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .ops-grid article {
    padding: 1.5rem;
    border: 1px solid var(--p-line);
  }
  .ops-grid article > p:first-child {
    font: 700 0.75rem monospace;
    color: #7659e8;
  }
  .ops-grid h3 {
    min-height: 4rem;
    font-size: 1.6rem;
  }
  .ops-grid dl div {
    display: flex;
    justify-content: space-between;
    padding: 0.75rem 0;
    border-top: 1px solid var(--p-line);
  }
  .ops-grid article > p:last-child {
    color: var(--p-muted);
    line-height: 1.55;
  }
  .maintenance {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 3px solid var(--p-ink);
  }
  .maintenance h3 {
    font-size: clamp(2rem, 4vw, 4rem);
    line-height: 0.95;
  }
  .maintenance ul {
    list-style: none;
    padding: 0;
  }
  .maintenance li {
    display: flex;
    justify-content: space-between;
    padding: 1rem 0;
    border-bottom: 1px solid var(--p-line);
  }
  .handoff {
    padding: 0;
    list-style: none;
  }
  .handoff li {
    display: grid;
    grid-template-columns: 0.2fr 1fr;
    padding: 2rem 0;
    border-top: 1px solid var(--p-line);
  }
  .handoff li > span {
    color: var(--p-accent);
    font: 700 1rem monospace;
  }
  .handoff h3 {
    margin: 0 0 0.5rem;
    font-size: clamp(1.5rem, 3vw, 3rem);
  }
  .handoff p {
    max-width: 55rem;
    margin: 0;
    color: var(--p-muted);
    line-height: 1.6;
  }
  .section--sources {
    background: #131315;
  }
  .sources {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--p-line);
  }
  .sources a {
    display: flex;
    min-height: 9rem;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.25rem;
    background: #131315;
    color: inherit;
    text-decoration: none;
  }
  .sources a:hover,
  .sources a:focus-visible {
    background: var(--p-accent);
    color: var(--p-ink);
    outline: none;
  }
  .sources span {
    font-size: 0.72rem;
    color: var(--p-muted);
  }
  .sources a:hover span {
    color: inherit;
  }
  .caveat {
    max-width: 70rem;
    margin: 2rem 0 0;
    color: var(--p-muted);
    line-height: 1.6;
  }
  @media (max-width: 800px) {
    .pricing-nav div {
      display: none;
    }
    .hero-grid,
    .section-heading,
    .tier-columns,
    .ops-grid,
    .maintenance {
      grid-template-columns: 1fr;
    }
    .decision-strip {
      grid-template-columns: 1fr 1fr;
    }
    .decision-strip p {
      grid-column: 1/-1;
    }
    .tier-top {
      display: block;
    }
    .tier-top span {
      display: block;
      margin-top: 1rem;
    }
    .demo-links {
      grid-template-columns: 1fr;
    }
    .metrics {
      grid-template-columns: 1fr;
    }
    .sources {
      grid-template-columns: 1fr;
    }
    .hero {
      min-height: auto;
    }
    .hero h1 {
      margin: 5rem 0;
    }
    .section-heading {
      gap: 0.75rem;
    }
    .maintenance {
      gap: 1rem;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .tier {
      animation: rise 0.45s ease both;
    }
    @keyframes rise {
      from {
        opacity: 0;
        transform: translateY(12px);
      }
    }
  }
</style>
